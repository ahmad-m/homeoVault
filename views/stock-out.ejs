<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stock Out Remedy - HomeoVault</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/core.css">
  <link rel="stylesheet" href="/css/inventory.css">
</head>
<body>

  <%- include('partials/header') %>

  <!-- Stock-Out Form Main -->
  <main class="py-xl" style="background: radial-gradient(circle at top right, rgba(16, 185, 129, 0.03), transparent 60%); min-height: 85vh;">
    <div class="container" style="max-width:800px;">

      <!-- Breadcrumbs -->
      <ul class="reusable-breadcrumb">
        <li><a href="/">Home</a></li>
        <li><a href="/dashboard">Dashboard</a></li>
        <li><a href="/inventory.html">Inventory</a></li>
        <li style="color:var(--primary);">Stock Out</li>
      </ul>

      <div style="margin-bottom:32px;">
        <h1 style="font-family:var(--font-heading); font-size:2.2rem; font-weight:800; color:var(--danger); margin-bottom:5px;">Deduct Stock Out</h1>
        <p class="text-secondary" style="font-size:0.95rem;">Record a stock consumption or remove an expired lot.</p>
      </div>

      <div class="reusable-card" style="border-top: 4px solid var(--danger);">
        <form id="stock-out-form">
          
          <!-- Medicine Autocomplete -->
          <div class="form-group search-container" style="margin-bottom:24px;">
            <label class="form-label" style="display:block;margin-bottom:8px;font-weight:600;">Search Remedy Name *</label>
            <input type="text" id="stockout-med-autocomplete" class="material-input search-input" placeholder="Type medicine name to search..." required autocomplete="off">
            <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="top:75%;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <div class="autocomplete-dropdown" id="stockout-med-dropdown"></div>
          </div>

          <!-- Batches Dropdown -->
          <div class="form-group" style="margin-bottom:24px;">
            <label for="batch_select" class="form-label" style="display:block;margin-bottom:8px;font-weight:600;">Active Batch Lot *</label>
            <select class="material-select" id="batch_select" required>
              <option value="">-- Choose Remedy First --</option>
            </select>
          </div>

          <!-- Quantity -->
          <div class="form-group" style="margin-bottom:24px;">
            <label for="quantity" class="form-label" style="display:block;margin-bottom:8px;font-weight:600;">Deduction Quantity *</label>
            <input type="number" id="quantity" class="material-input" placeholder="e.g. 1" min="1" required>
          </div>

          <!-- Remarks -->
          <div class="form-group" style="margin-bottom:32px;">
            <label for="remarks" class="form-label" style="display:block;margin-bottom:8px;font-weight:600;">Reason / Remarks *</label>
            <textarea id="remarks" class="material-input" style="height:80px; resize:none;" placeholder="Reason for stock out (e.g. Family consumption, Expired lot discard)..." required></textarea>
          </div>

          <div style="display:flex; justify-content:flex-end; gap:12px;">
            <a href="/inventory.html" class="reusable-btn reusable-btn-secondary">Cancel</a>
            <button type="submit" class="reusable-btn reusable-btn-primary" style="background-color:var(--danger);">Deduct Stock Out</button>
          </div>

        </form>
      </div>

    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/app.js"></script>
  <script src="/js/core.js"></script>
  <script src="/js/inventory.js"></script>
</body>
</html>
