<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Database Backups - HomeoVault</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/core.css">
  <link rel="stylesheet" href="/css/settings.css">
</head>
<body>

  <%- include('partials/header') %>

  <!-- Backups Panel Main -->
  <main class="py-xl" style="background: radial-gradient(circle at top right, rgba(16, 185, 129, 0.03), transparent 60%); min-height: 85vh;">
    <div class="container" style="max-width: 800px;">

      <!-- Breadcrumbs -->
      <ul class="reusable-breadcrumb">
        <li><a href="/">Home</a></li>
        <li><a href="/dashboard">Dashboard</a></li>
        <li><a href="/settings.html">Settings</a></li>
        <li style="color:var(--primary);">Backups Ledger</li>
      </ul>

      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; margin-bottom:32px;">
        <div>
          <h1 style="font-family:var(--font-heading); font-size:2.2rem; font-weight:800; margin-bottom:5px;">Database Backups</h1>
          <p class="text-secondary" style="font-size:0.95rem;">Generate and catalog offline backups of medicines datasets.</p>
        </div>
        
        <button class="reusable-btn reusable-btn-primary" id="btn-create-backup">💾 Create Backup Now</button>
      </div>

      <div class="reusable-card">
        <h3 style="font-family:var(--font-heading); font-size:1.15rem; font-weight:700; margin-bottom:20px;">Backup History</h3>
        
        <div id="backups-list-container">
          <div style="text-align:center; padding:20px;">
            <div class="spinner" style="margin:0 auto;"></div>
          </div>
        </div>
      </div>

    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/app.js"></script>
  <script src="/js/core.js"></script>
  <script src="/js/settings.js"></script>
</body>
</html>
