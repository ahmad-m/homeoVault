<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stock Inventory - HomeoVault</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/core.css">
  <link rel="stylesheet" href="/css/inventory.css">
</head>
<body>

  <%- include('partials/header') %>

  <!-- Content Area -->
  <main class="py-xl" style="background: radial-gradient(circle at top right, rgba(16, 185, 129, 0.03), transparent 60%); min-height: 85vh;">
    <div class="container">

      <!-- Breadcrumbs -->
      <ul class="reusable-breadcrumb">
        <li><a href="/">Home</a></li>
        <li><a href="/dashboard">Dashboard</a></li>
        <li style="color:var(--primary);">Inventory Stocks</li>
      </ul>

      <!-- Page Titles & Action buttons -->
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; margin-bottom:32px;">
        <div>
          <h1 style="font-family:var(--font-heading); font-size:2.2rem; font-weight:800; margin-bottom:5px;">Cabinet Inventory</h1>
          <p class="text-secondary" style="font-size:0.95rem;">Monitor remedy balances, track batches, and configure storage boxes.</p>
        </div>
        
        <div style="display:flex; gap:12px; flex-wrap:wrap;">
          <a href="/suppliers.html" class="reusable-btn reusable-btn-secondary" style="text-decoration:none;">Suppliers</a>
          <a href="/locations.html" class="reusable-btn reusable-btn-secondary" style="text-decoration:none;">Cabinet Boxes</a>
          <a href="/stock-out.html" class="reusable-btn reusable-btn-secondary" style="border-color:var(--danger);color:var(--danger);text-decoration:none;">Stock Out</a>
          <a href="/stock-in.html" class="reusable-btn reusable-btn-primary" style="text-decoration:none;">+ Stock In</a>
        </div>
      </div>

      <!-- Filters Form Card -->
      <div class="reusable-card" style="margin-bottom:24px; padding:20px;">
        <form id="inventory-search-form" style="display:grid; grid-template-columns: 1fr repeat(3, minmax(180px, 1fr)) auto; gap:15px; align-items:end;">
          
          <!-- Search input -->
          <div class="form-group" style="margin-bottom:0;">
            <div class="form-input-container">
              <input type="text" id="inventory-search-input" class="material-input" placeholder="Search medicine..." style="padding:10px 14px;">
            </div>
          </div>

          <!-- Category Select -->
          <div class="form-group" style="margin-bottom:0;">
            <select class="material-select" id="filter-category" style="padding:10px 14px;">
              <option value="">-- All Categories --</option>
            </select>
          </div>

          <!-- Location Select -->
          <div class="form-group" style="margin-bottom:0;">
            <select class="material-select" id="filter-location" style="padding:10px 14px;">
              <option value="">-- All Cabinet Locations --</option>
            </select>
          </div>

          <!-- Status Select -->
          <div class="form-group" style="margin-bottom:0;">
            <select class="material-select" id="filter-status" style="padding:10px 14px;">
              <option value="">-- All Statuses --</option>
              <option value="low_stock">Low Stock Warnings</option>
              <option value="out_of_stock">Out of Stock</option>
            </select>
          </div>

          <button type="submit" class="reusable-btn reusable-btn-primary" style="padding:10px 20px;">Search</button>
        </form>
      </div>

      <!-- Stock Table Card -->
      <div class="reusable-card" style="padding:0; overflow:hidden;">
        <div class="table-responsive">
          <table class="reusable-table">
            <thead>
              <tr>
                <th>Remedy Name</th>
                <th>Potency</th>
                <th>Category</th>
                <th>Current Qty</th>
                <th>Location Cabinet</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="inventory-table-body">
              <tr>
                <td colspan="7" style="text-align:center;">
                  <div class="spinner" style="margin:20px auto;"></div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        
        <!-- Pagination controls -->
        <div id="inventory-pagination"></div>
      </div>

    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/app.js"></script>
  <script src="/js/core.js"></script>
  <script src="/js/inventory.js"></script>
</body>
</html>
