<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Notification Center - HomeoVault</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/core.css">
  <link rel="stylesheet" href="/css/notifications.css">
</head>
<body>

  <%- include('partials/header') %>

  <!-- Notifications Panel Main -->
  <main class="py-xl" style="background: radial-gradient(circle at top right, rgba(16, 185, 129, 0.03), transparent 60%); min-height: 85vh;">
    <div class="container" style="max-width: 800px;">

      <!-- Breadcrumbs -->
      <ul class="reusable-breadcrumb">
        <li><a href="/">Home</a></li>
        <li><a href="/dashboard">Dashboard</a></li>
        <li style="color:var(--primary);">Notification Center</li>
      </ul>

      <!-- Page Titles & Preferences Actions Link -->
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; margin-bottom:32px;">
        <div>
          <h1 style="font-family:var(--font-heading); font-size:2.2rem; font-weight:800; margin-bottom:5px;">Notification Center</h1>
          <p class="text-secondary" style="font-size:0.95rem;">Monitor low-stock alerts, expiration warnings, and database jobs.</p>
        </div>
        
        <a href="/notification-settings.html" class="reusable-btn reusable-btn-secondary" style="text-decoration:none;">⚙️ Settings</a>
      </div>

      <!-- Filters Row Card -->
      <div class="reusable-card" style="margin-bottom:24px; padding:16px 20px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
        <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
          
          <!-- Filter by Type -->
          <div class="form-group" style="margin-bottom:0; width:160px;">
            <select class="material-select" id="filter-notification-type" style="padding:6px 12px; font-size:0.85rem;">
              <option value="">-- All Alert Types --</option>
              <option value="LOW_STOCK">Low Stock</option>
              <option value="OUT_OF_STOCK">Out of Stock</option>
              <option value="EXPIRED">Expired Lots</option>
              <option value="EXPIRY_7">Expiring (7 Days)</option>
              <option value="EXPIRY_30">Expiring (30 Days)</option>
              <option value="SYSTEM_ERROR">System Errors</option>
            </select>
          </div>

          <!-- Filter by Read/Unread -->
          <div class="form-group" style="margin-bottom:0; width:150px;">
            <select class="material-select" id="filter-read-status" style="padding:6px 12px; font-size:0.85rem;">
              <option value="">-- Read/Unread --</option>
              <option value="false">Unread Alerts</option>
              <option value="true">Read Alerts</option>
            </select>
          </div>

        </div>

        <button class="reusable-btn reusable-btn-secondary" id="btn-mark-all-read" style="padding:6px 14px; font-size:0.85rem;">Mark All as Read</button>
      </div>

      <!-- Notifications List Wrapper -->
      <div class="notifications-wrapper" id="notifications-list">
        <div style="text-align:center; padding:40px;">
          <div class="spinner" style="margin:0 auto;"></div>
        </div>
      </div>

      <!-- Pagination Container -->
      <div id="notifications-pagination" style="margin-top:24px;"></div>

    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/app.js"></script>
  <script src="/js/core.js"></script>
  <script src="/js/notifications.js"></script>
</body>
</html>
