<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stock In Remedy - HomeoVault</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/core.css">
  <link rel="stylesheet" href="/css/inventory.css">
</head>
<body>

  <%- include('partials/header') %>

  <!-- Stock-In Form Main -->
  <main class="py-xl" style="background: radial-gradient(circle at top right, rgba(16, 185, 129, 0.03), transparent 60%); min-height: 85vh;">
    <div class="container" style="max-width:800px;">

      <!-- Breadcrumbs -->
      <ul class="reusable-breadcrumb">
        <li><a href="/">Home</a></li>
        <li><a href="/dashboard">Dashboard</a></li>
        <li><a href="/inventory.html">Inventory</a></li>
        <li style="color:var(--primary);">Stock In</li>
      </ul>

      <div style="margin-bottom:32px;">
        <h1 style="font-family:var(--font-heading); font-size:2.2rem; font-weight:800; margin-bottom:5px;">Receive Stock In</h1>
        <p class="text-secondary" style="font-size:0.95rem;">Catalog new remedy packages and specify storage lots.</p>
      </div>

      <div class="reusable-card">
        <form id="stock-in-form">
          
          <!-- Medicine Autocomplete -->
          <div class="form-group search-container" style="margin-bottom:24px;">
            <label class="form-label" style="display:block;margin-bottom:8px;font-weight:600;">Search Remedy Name *</label>
            <input type="text" id="med-autocomplete-input" class="material-input search-input" placeholder="Type medicine name to search..." required autocomplete="off">
            <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="top:75%;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <div class="autocomplete-dropdown" id="med-autocomplete-dropdown"></div>
          </div>

          <!-- Potency and Location row -->
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:24px;">
            <div class="form-group" style="margin-bottom:0;">
              <label for="potency_select" class="form-label" style="display:block;margin-bottom:8px;font-weight:600;">Potency *</label>
              <select class="material-select" id="potency_select" required>
                <option value="">-- Choose Remedy First --</option>
              </select>
            </div>

            <div class="form-group" style="margin-bottom:0;">
              <label for="location_select" class="form-label" style="display:block;margin-bottom:8px;font-weight:600;">Cabinet Storage Location</label>
              <select class="material-select" id="location_select">
                <option value="">-- Choose Storage Box --</option>
              </select>
            </div>
          </div>

          <!-- Batch details row -->
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:24px;">
            <div class="form-group" style="margin-bottom:0;">
              <label for="batch_number" class="form-label" style="display:block;margin-bottom:8px;font-weight:600;">Batch Code / Lot Number *</label>
              <input type="text" id="batch_number" class="material-input" placeholder="e.g. B-9981" required>
            </div>

            <div class="form-group" style="margin-bottom:0;">
              <label for="expiry_date" class="form-label" style="display:block;margin-bottom:8px;font-weight:600;">Expiration Date <span style="font-size:0.78rem;color:var(--text-muted);font-weight:400;">(optional)</span></label>
              <input type="date" id="expiry_date" class="material-input">
            </div>
          </div>

          <!-- Prices and Quantity row -->
          <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:20px; margin-bottom:24px;">
            <div class="form-group" style="margin-bottom:0;">
              <label for="purchase_price" class="form-label" style="display:block;margin-bottom:8px;font-weight:600;">Purchase Cost ($)</label>
              <input type="number" id="purchase_price" class="material-input" placeholder="0.00" step="0.01" min="0">
            </div>

            <div class="form-group" style="margin-bottom:0;">
              <label for="mrp" class="form-label" style="display:block;margin-bottom:8px;font-weight:600;">MRP ($)</label>
              <input type="number" id="mrp" class="material-input" placeholder="0.00" step="0.01" min="0">
            </div>

            <div class="form-group" style="margin-bottom:0;">
              <label for="quantity" class="form-label" style="display:block;margin-bottom:8px;font-weight:600;">Quantity *</label>
              <input type="number" id="quantity" class="material-input" placeholder="e.g. 5" min="1" required>
            </div>
          </div>

          <!-- Supplier select -->
          <div class="form-group" style="margin-bottom:24px;">
            <label for="supplier_select" class="form-label" style="display:block;margin-bottom:8px;font-weight:600;">Supplier Distributor</label>
            <select class="material-select" id="supplier_select">
              <option value="">-- Choose Supplier --</option>
            </select>
          </div>

          <!-- Remarks -->
          <div class="form-group" style="margin-bottom:32px;">
            <label for="remarks" class="form-label" style="display:block;margin-bottom:8px;font-weight:600;">Remarks / Notes</label>
            <textarea id="remarks" class="material-input" style="height:80px; resize:none;" placeholder="Optional transaction details..."></textarea>
          </div>

          <div style="display:flex; justify-content:flex-end; gap:12px;">
            <a href="/inventory.html" class="reusable-btn reusable-btn-secondary">Cancel</a>
            <button type="submit" class="reusable-btn reusable-btn-primary">Receive Stock In</button>
          </div>

        </form>
      </div>

    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/app.js"></script>
  <script src="/js/core.js"></script>
  <script src="/js/inventory.js"></script>
</body>
</html>
