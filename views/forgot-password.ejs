<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password - HomeoVault</title>
  <link class="styles" rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link class="auth-styles" rel="stylesheet" href="/css/auth.css">
</head>
<body class="auth-body">

  <div class="auth-card">
    <div class="auth-header">
      <a href="/" class="auth-logo">
        <div class="logo-icon">H</div>
        Homeo<span>Vault</span>
      </a>
      <h2 class="auth-title">Recover Credentials</h2>
      <p class="auth-subtitle">Provide your email address to receive a secure recovery key link.</p>
    </div>

    <!-- Message Alert Panel -->
    <div class="alert alert-danger" id="auth-alert"></div>

    <form id="forgot-form">
      <!-- Email Input -->
      <div class="form-group">
        <div class="form-input-container">
          <input type="email" id="email" class="form-input" placeholder=" " required autocomplete="email">
          <label for="email" class="form-label">Email Address</label>
        </div>
      </div>

      <!-- Action Button -->
      <button type="submit" class="btn-submit">Dispatch Reset Code</button>
    </form>

    <div class="auth-footer">
      Remembered credentials? <a href="/login.html" class="auth-link">Return to Sign In</a>
    </div>
  </div>

  <script src="/js/app.js"></script>
  <script src="/js/auth.js"></script>
</body>
</html>
