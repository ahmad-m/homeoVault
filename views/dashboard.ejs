<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard & Analytics - HomeoVault</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/core.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <!-- Include Chart.js via JSDeliver CDN for Analytics Charts -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

  <%- include('partials/header') %>

  <!-- Dashboard Main Panel -->
  <main class="py-xl" style="background: radial-gradient(circle at top right, rgba(16, 185, 129, 0.04), transparent 60%); min-height: 85vh;">
    <div class="container">

      <!-- Breadcrumbs -->
      <ul class="reusable-breadcrumb">
        <li><a href="/">Home</a></li>
        <li style="color:var(--primary);">Dashboard Panel</li>
      </ul>

      <!-- Page Titles & Global Search Bar -->
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:20px; margin-bottom:32px;">
        <div>
          <h1 style="font-family:var(--font-heading); font-size:2.2rem; font-weight:800; margin-bottom:5px;">Dashboard</h1>
          <p class="text-secondary" style="font-size:0.95rem;">System overview, stock movements, and collection analytics.</p>
        </div>

        <form id="dashboard-global-search-form" class="search-container" style="max-width:350px; width:100%;">
          <input type="text" id="dashboard-search-input" class="material-input search-input" placeholder="Global catalog search..." autocomplete="off">
          <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </form>
      </div>

      <!-- Quick Actions Grid -->
      <div class="quick-actions-bar">
        <a href="/stock-in.html" class="action-btn-card">
          <div class="action-btn-icon">📥</div>
          <div class="action-btn-label">Receive Stock</div>
        </a>
        <a href="/stock-out.html" class="action-btn-card">
          <div class="action-btn-icon" style="color:var(--danger);">📤</div>
          <div class="action-btn-label">Deduct Stock</div>
        </a>
        <a href="/medicines.html" class="action-btn-card">
          <div class="action-btn-icon">🔍</div>
          <div class="action-btn-label">Search Medicine</div>
        </a>
        <a href="/inventory.html" class="action-btn-card">
          <div class="action-btn-icon">📦</div>
          <div class="action-btn-label">View Inventory</div>
        </a>
        <a href="/medicines.html" class="action-btn-card">
          <div class="action-btn-icon">💊</div>
          <div class="action-btn-label">Manage Medicines</div>
        </a>
        <a href="/suppliers.html" class="action-btn-card">
          <div class="action-btn-icon">🤝</div>
          <div class="action-btn-label">Manage Suppliers</div>
        </a>
        <a href="/locations.html" class="action-btn-card">
          <div class="action-btn-icon">🗄️</div>
          <div class="action-btn-label">Cabinet Settings</div>
        </a>
      </div>

      <!-- KPI Summary Cards -->
      <div class="kpi-grid">
        <!-- Total Medicines -->
        <div class="reusable-card kpi-card">
          <span class="kpi-title">Total Remedies</span>
          <span class="kpi-value" id="kpi-total-medicines"><span class="skeleton" style="width:50px;height:36px;"></span></span>
          <span class="kpi-sub">Master medicine catalog</span>
        </div>

        <!-- Total Inventory items -->
        <div class="reusable-card kpi-card">
          <span class="kpi-title">Inventory Items</span>
          <span class="kpi-value" id="kpi-total-items"><span class="skeleton" style="width:50px;height:36px;"></span></span>
          <span class="kpi-sub">Unique remedy-potency sets</span>
        </div>

        <!-- Total Available Stock -->
        <div class="reusable-card kpi-card">
          <span class="kpi-title">Available Stock</span>
          <span class="kpi-value" id="kpi-total-stock"><span class="skeleton" style="width:50px;height:36px;"></span></span>
          <span class="kpi-sub">Total physical units</span>
        </div>

        <!-- Valuation -->
        <div class="reusable-card kpi-card kpi-info">
          <span class="kpi-title">Inventory Value</span>
          <span class="kpi-value" id="kpi-valuation" style="font-size:1.6rem;padding-top:10px;">$0.00</span>
          <span class="kpi-sub">Total purchase valuation</span>
        </div>
      </div>

      <div class="kpi-grid">
        <!-- Low Stock -->
        <div class="reusable-card kpi-card kpi-warning">
          <span class="kpi-title">Low Stock</span>
          <span class="kpi-value" id="kpi-low-stock"><span class="skeleton" style="width:50px;height:36px;"></span></span>
          <span class="kpi-sub">Below min reorder levels</span>
        </div>

        <!-- Out of Stock -->
        <div class="reusable-card kpi-card kpi-danger">
          <span class="kpi-title">Out of Stock</span>
          <span class="kpi-value" id="kpi-out-of-stock"><span class="skeleton" style="width:50px;height:36px;"></span></span>
          <span class="kpi-sub">Balance is zero</span>
        </div>

        <!-- Expired -->
        <div class="reusable-card kpi-card kpi-danger">
          <span class="kpi-title">Expired Lots</span>
          <span class="kpi-value" id="kpi-expired"><span class="skeleton" style="width:50px;height:36px;"></span></span>
          <span class="kpi-sub">Requires disposal discard</span>
        </div>

        <!-- Expiring 30 days -->
        <div class="reusable-card kpi-card kpi-warning">
          <span class="kpi-title">Expiring 30 Days</span>
          <span class="kpi-value" id="kpi-expiring-30"><span class="skeleton" style="width:50px;height:36px;"></span></span>
          <span class="kpi-sub">Expiring within a month</span>
        </div>
      </div>

      <div class="kpi-grid">
        <!-- Today In -->
        <div class="reusable-card kpi-card">
          <span class="kpi-title">Today's Receipts</span>
          <span class="kpi-value" id="kpi-today-in"><span class="skeleton" style="width:50px;height:36px;"></span></span>
          <span class="kpi-sub">Stock loaded today</span>
        </div>

        <!-- Today Out -->
        <div class="reusable-card kpi-card kpi-danger">
          <span class="kpi-title">Today's Outflows</span>
          <span class="kpi-value" id="kpi-today-out"><span class="skeleton" style="width:50px;height:36px;"></span></span>
          <span class="kpi-sub">Stock deducted today</span>
        </div>

        <!-- Suppliers -->
        <div class="reusable-card kpi-card">
          <span class="kpi-title">Suppliers</span>
          <span class="kpi-value" id="kpi-suppliers"><span class="skeleton" style="width:50px;height:36px;"></span></span>
          <span class="kpi-sub">Registered pharmacies</span>
        </div>

        <!-- Categories -->
        <div class="reusable-card kpi-card">
          <span class="kpi-title">Categories</span>
          <span class="kpi-value" id="kpi-categories"><span class="skeleton" style="width:50px;height:36px;"></span></span>
          <span class="kpi-sub">Active classifications</span>
        </div>
      </div>

      <!-- Charts Section -->
      <div class="charts-grid">
        <!-- Monthly Trends -->
        <div class="reusable-card chart-card">
          <h3 class="chart-title">Monthly Stock Movements</h3>
          <div class="chart-canvas-wrapper">
            <canvas id="monthly-trends-chart"></canvas>
          </div>
        </div>

        <!-- Category Pie Chart -->
        <div class="reusable-card chart-card">
          <h3 class="chart-title">Category Distribution</h3>
          <div class="chart-canvas-wrapper">
            <canvas id="category-ratio-chart"></canvas>
          </div>
        </div>
      </div>

      <div class="charts-grid">
        <!-- Top Used Medicines -->
        <div class="reusable-card chart-card">
          <h3 class="chart-title">Top Consumed Medicines</h3>
          <div class="chart-canvas-wrapper">
            <canvas id="top-used-chart"></canvas>
          </div>
        </div>

        <!-- Most Stocked Medicines -->
        <div class="reusable-card chart-card">
          <h3 class="chart-title">Most Stocked Remedies</h3>
          <div class="chart-canvas-wrapper">
            <canvas id="most-stocked-chart"></canvas>
          </div>
        </div>
      </div>

      <!-- Split Table Panels -->
      <div class="dashboard-content-split">
        <!-- Recent Activities Table -->
        <div class="reusable-card" style="padding:0; overflow:hidden;">
          <h3 style="font-family:var(--font-heading); font-size:1.15rem; font-weight:700; padding:20px 24px; border-bottom: 1px solid var(--border);">Recent Stock Activities</h3>
          <div class="table-responsive" style="border:none; border-radius:0;">
            <table class="reusable-table">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Remedy</th>
                  <th>Potency</th>
                  <th>Type</th>
                  <th>Quantity</th>
                  <th>Operator</th>
                </tr>
              </thead>
              <tbody id="recent-activity-body">
                <tr>
                  <td colspan="6" style="text-align:center;"><div class="spinner" style="margin:20px auto;"></div></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Low Stock Warning list -->
        <div class="reusable-card" style="padding:0; overflow:hidden;">
          <h3 style="font-family:var(--font-heading); font-size:1.15rem; font-weight:700; padding:20px 24px; border-bottom: 1px solid var(--border); color:var(--warning);">Low Stock Cabinet Warnings</h3>
          <div class="table-responsive" style="border:none; border-radius:0;">
            <table class="reusable-table">
              <thead>
                <tr>
                  <th>Remedy</th>
                  <th>Potency</th>
                  <th>Stock Balance</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="low-stock-body">
                <tr>
                  <td colspan="4" style="text-align:center;"><div class="spinner" style="margin:20px auto;"></div></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/app.js"></script>
  <script src="/js/core.js"></script>
  <script src="/js/dashboard.js"></script>
</body>
</html>
