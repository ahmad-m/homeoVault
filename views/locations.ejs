<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Storage Cabinet Locations - HomeoVault</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/core.css">
  <link rel="stylesheet" href="/css/inventory.css">
</head>
<body>

  <%- include('partials/header') %>

  <!-- Locations Main Area -->
  <main class="py-xl" style="background: radial-gradient(circle at top right, rgba(16, 185, 129, 0.03), transparent 60%); min-height: 85vh;">
    <div class="container" style="max-width: 900px;">

      <!-- Breadcrumbs -->
      <ul class="reusable-breadcrumb">
        <li><a href="/">Home</a></li>
        <li><a href="/dashboard">Dashboard</a></li>
        <li><a href="/inventory.html">Inventory</a></li>
        <li style="color:var(--primary);">Cabinet Boxes</li>
      </ul>

      <div style="margin-bottom:32px;">
        <h1 style="font-family:var(--font-heading); font-size:2.2rem; font-weight:800; margin-bottom:5px;">Storage Cabinets</h1>
        <p class="text-secondary" style="font-size:0.95rem;">Configure physical cabinet boxes, bedrooms drawers, or travel kits.</p>
      </div>

      <!-- Split Grid Layout -->
      <div class="inventory-split-layout">
        
        <!-- Left Column: Add Location Form -->
        <section class="reusable-card">
          <h3 style="font-family:var(--font-heading); font-size:1.15rem; font-weight:600; margin-bottom:20px;">Add Cabinet Box</h3>
          <form id="location-form">
            <div class="form-group">
              <label for="location_name" class="form-label" style="display:block;margin-bottom:8px;">Cabinet Name *</label>
              <input type="text" id="location_name" class="material-input" placeholder="e.g. Study Room Cabinet" required>
            </div>

            <div class="form-group" style="margin-bottom:24px;">
              <label for="description" class="form-label" style="display:block;margin-bottom:8px;">Cabinet Description</label>
              <textarea id="description" class="material-input" style="height:80px;resize:none;" placeholder="Detail storage box placement..."></textarea>
            </div>

            <button type="submit" class="reusable-btn reusable-btn-primary" style="width:100%;">Create Cabinet Location</button>
          </form>
        </section>

        <!-- Right Column: Locations List Table -->
        <section class="reusable-card" style="padding:0; overflow:hidden;">
          <div class="table-responsive">
            <table class="reusable-table">
              <thead>
                <tr>
                  <th>Cabinet Name</th>
                  <th>Placement Description</th>
                </tr>
              </thead>
              <tbody id="locations-table-body">
                <tr>
                  <td colspan="2" style="text-align:center;">
                    <div class="spinner" style="margin:20px auto;"></div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

      </div>

    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/app.js"></script>
  <script src="/js/core.js"></script>
  <script src="/js/inventory.js"></script>
</body>
</html>
