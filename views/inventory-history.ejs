<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Transaction History - HomeoVault</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/core.css">
  <link rel="stylesheet" href="/css/inventory.css">
</head>
<body>

  <%- include('partials/header') %>

  <!-- History Panel Main -->
  <main class="py-xl" style="background: radial-gradient(circle at top right, rgba(16, 185, 129, 0.03), transparent 60%); min-height: 85vh;">
    <div class="container">

      <!-- Breadcrumbs -->
      <ul class="reusable-breadcrumb">
        <li><a href="/">Home</a></li>
        <li><a href="/dashboard">Dashboard</a></li>
        <li><a href="/inventory.html">Inventory</a></li>
        <li style="color:var(--primary);">Transactions History</li>
      </ul>

      <div style="margin-bottom:32px;">
        <h1 style="font-family:var(--font-heading); font-size:2.2rem; font-weight:800; margin-bottom:5px;">Transactions Ledger</h1>
        <p class="text-secondary" style="font-size:0.95rem;">Chronological journal audit logs of all stock receipts, outputs, and overrides.</p>
      </div>

      <!-- Ledger Table Card -->
      <div class="reusable-card" style="padding:0; overflow:hidden;">
        <div class="table-responsive">
          <table class="reusable-table">
            <thead>
              <tr>
                <th>Date & Time</th>
                <th>Remedy Name</th>
                <th>Potency</th>
                <th>Type</th>
                <th>Qty Change</th>
                <th>Batch Code</th>
                <th>Remarks / Notes</th>
              </tr>
            </thead>
            <tbody id="history-table-body">
              <tr>
                <td colspan="7" style="text-align:center;">
                  <div class="spinner" style="margin:20px auto;"></div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/app.js"></script>
  <script src="/js/core.js"></script>
  <script src="/js/inventory.js"></script>
</body>
</html>
