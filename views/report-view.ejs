<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Report Viewer - HomeoVault</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/core.css">
  <link rel="stylesheet" href="/css/reports.css">
</head>
<body>

  <!-- Printer Header Block (Visible ONLY during print layout) -->
  <div id="print-report-header">
    <div class="print-header-top">
      <div class="print-logo">HomeoVault</div>
      <div style="font-size: 8pt; color: #475569;">Homeopathic Inventory System</div>
    </div>
    <h2 class="print-title" id="print-viewer-title">Master Report</h2>
    <div style="margin-top:10px; font-size: 8.5pt; color: #334155; display:flex; justify-content:space-between;">
      <div>Generated By: <strong id="print-operator-name">System</strong></div>
      <div>Date: <strong>${new Date().toLocaleDateString()}</strong></div>
    </div>
  </div>

  <%- include('partials/header') %>

  <!-- Viewer Workspace -->
  <main class="py-xl" style="background: radial-gradient(circle at top right, rgba(16, 185, 129, 0.03), transparent 60%); min-height: 85vh;">
    <div class="container">

      <!-- Breadcrumbs -->
      <ul class="reusable-breadcrumb">
        <li><a href="/">Home</a></li>
        <li><a href="/dashboard">Dashboard</a></li>
        <li><a href="/reports.html">Reports</a></li>
        <li style="color:var(--primary);">Viewer</li>
      </ul>

      <!-- Title Bar -->
      <div style="margin-bottom:32px;">
        <h1 style="font-family:var(--font-heading); font-size:2.2rem; font-weight:800; margin-bottom:5px;" id="report-viewer-title">Report File</h1>
        <p class="text-secondary" style="font-size:0.95rem;">Apply custom filter matrices and export datasets below.</p>
      </div>

      <!-- Main Columns splits -->
      <div class="report-view-layout">
        
        <!-- Left: Filters card -->
        <aside class="reusable-card" style="height:fit-content; position:sticky; top:90px;">
          <h3 style="font-family:var(--font-heading); font-size:1.1rem; font-weight:700; margin-bottom:20px;">Report Filters</h3>
          
          <form id="report-filters-form">
            <!-- Dynamic elements parsed by JS -->
            <div id="dynamic-filters-container">
              <p class="text-secondary" style="font-size:0.85rem;">No filters required for this report.</p>
            </div>
            
            <button type="submit" class="reusable-btn reusable-btn-primary" style="width:100%; margin-top:20px;">Apply Filters</button>
          </form>
        </aside>

        <!-- Right: Actions & Data Table -->
        <section style="display:flex; flex-direction:column; gap:24px;">
          
          <!-- Actions Row -->
          <div class="reusable-card export-action-row" style="padding:12px 20px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
            <div style="font-size:0.9rem; color:var(--text-secondary); font-weight:600;">Download Report:</div>
            
            <div style="display:flex; gap:10px; flex-wrap:wrap;">
              <button class="reusable-btn reusable-btn-secondary" id="btn-print-report" style="padding:8px 14px; font-size:0.82rem;">🖨️ Print Layout</button>
              <button class="reusable-btn reusable-btn-secondary" id="btn-export-csv" style="padding:8px 14px; font-size:0.82rem;">CSV File</button>
              <button class="reusable-btn reusable-btn-secondary" id="btn-export-excel" style="padding:8px 14px; font-size:0.82rem;">Excel XLS</button>
              <button class="reusable-btn reusable-btn-primary" id="btn-export-pdf" style="padding:8px 14px; font-size:0.82rem;">PDF Document</button>
            </div>
          </div>

          <!-- Report Data Table -->
          <div class="reusable-card" style="padding:0; overflow:hidden;">
            <div class="table-responsive">
              <table class="reusable-table">
                <thead id="report-table-header">
                  <!-- Generated dynamically by reports.js -->
                </thead>
                <tbody id="report-table-body">
                  <tr>
                    <td style="text-align:center; padding:40px;">
                      <div class="spinner" style="margin:0 auto;"></div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Pagination container -->
            <div id="report-pagination"></div>
          </div>

        </section>

      </div>

    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/app.js"></script>
  <script src="/js/core.js"></script>
  <script src="/js/reports.js"></script>
</body>
</html>
