<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password - HomeoVault</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body class="auth-body">

  <div class="auth-card">
    <div class="auth-header">
      <a href="/" class="auth-logo">
        <div class="logo-icon">H</div>
        Homeo<span>Vault</span>
      </a>
      <h2 class="auth-title">Update Password</h2>
      <p class="auth-subtitle">Verify your secure reset token and set a new password.</p>
    </div>

    <!-- Alert Box -->
    <div class="alert alert-danger" id="auth-alert"></div>

    <form id="reset-form">
      <!-- Password Input -->
      <div class="form-group">
        <div class="form-input-container">
          <input type="password" id="password" class="form-input" placeholder=" " required autocomplete="new-password">
          <label for="password" class="form-label">New Password</label>
          <button type="button" class="password-toggle" aria-label="Toggle Password Visibility">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
          </button>
        </div>
        <p class="text-muted mt-sm" style="font-size: 0.72rem; line-height: 1.3;">Must be &ge; 8 characters and include uppercase, lowercase, digit, and special symbol.</p>
      </div>

      <!-- Confirm Password Input -->
      <div class="form-group">
        <div class="form-input-container">
          <input type="password" id="confirm_password" class="form-input" placeholder=" " required autocomplete="new-password">
          <label for="confirm_password" class="form-label">Confirm New Password</label>
          <button type="button" class="password-toggle" aria-label="Toggle Password Visibility">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
          </button>
        </div>
      </div>

      <!-- Submit Action -->
      <button type="submit" class="btn-submit mt-sm">Update Password</button>
    </form>

    <div class="auth-footer">
      Remembered credentials? <a href="/login.html" class="auth-link">Return to Sign In</a>
    </div>
  </div>

  <script src="/js/app.js"></script>
  <script src="/js/auth.js"></script>
</body>
</html>
