<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Profile - HomeoVault</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>

  <%- include('partials/header') %>

  <!-- Profile Content Area -->
  <main class="py-xl" style="background: radial-gradient(circle at top right, rgba(16, 185, 129, 0.04), transparent 50%); min-height: 80vh;">
    <div class="container">
      
      <div class="profile-avatar-section">
        <div class="profile-avatar" id="avatar-initials">U</div>
        <h2 style="font-family: var(--font-heading); font-size: 1.75rem; font-weight: 700; margin-bottom: 5px;">Your Profile Settings</h2>
        <p class="text-secondary" style="font-size: 0.9rem;">Manage personal contact information and system credentials.</p>
      </div>

      <div class="profile-grid">
        
        <!-- Left Side: Profile Info Form -->
        <section class="card">
          <h3 class="card-title" style="margin-bottom: var(--spacing-lg);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            Personal Information
          </h3>
          <form id="profile-form">
            <!-- Email (Read-Only) -->
            <div class="form-group">
              <div class="form-input-container">
                <input type="email" id="profile_email" class="form-input" placeholder=" " readonly style="opacity: 0.6; cursor: not-allowed; background-color: var(--bg-secondary);">
                <label for="profile_email" class="form-label" style="color: var(--text-muted);">Email (Locked)</label>
              </div>
            </div>

            <!-- Names -->
            <div style="display: flex; gap: 15px; margin-bottom: 24px;">
              <div class="form-input-container" style="flex: 1;">
                <input type="text" id="first_name" class="form-input" placeholder=" " required autocomplete="given-name">
                <label for="first_name" class="form-label">First Name</label>
              </div>
              <div class="form-input-container" style="flex: 1;">
                <input type="text" id="last_name" class="form-input" placeholder=" " required autocomplete="family-name">
                <label for="last_name" class="form-label">Last Name</label>
              </div>
            </div>

            <!-- Mobile -->
            <div class="form-group">
              <div class="form-input-container">
                <input type="tel" id="mobile" class="form-input" placeholder=" " autocomplete="tel">
                <label for="mobile" class="form-label">Mobile Phone Number</label>
              </div>
            </div>

            <!-- Avatar Link -->
            <div class="form-group">
              <div class="form-input-container">
                <input type="url" id="profile_image" class="form-input" placeholder=" " autocomplete="url">
                <label for="profile_image" class="form-label">Profile Image URL</label>
              </div>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; padding: 12px; font-weight: 600;">Save Changes</button>
          </form>
        </section>

        <!-- Right Side: Change Password Form -->
        <section class="card">
          <h3 class="card-title" style="margin-bottom: var(--spacing-lg); color: var(--danger);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            Security & Password
          </h3>
          <form id="profile-password-form">
            <!-- Current Password -->
            <div class="form-group">
              <div class="form-input-container">
                <input type="password" id="current_password" class="form-input" placeholder=" " required autocomplete="current-password">
                <label for="current_password" class="form-label">Current Password</label>
                <button type="button" class="password-toggle" aria-label="Toggle Password Visibility">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </button>
              </div>
            </div>

            <!-- New Password -->
            <div class="form-group">
              <div class="form-input-container">
                <input type="password" id="new_password" class="form-input" placeholder=" " required autocomplete="new-password">
                <label for="new_password" class="form-label">New Password</label>
                <button type="button" class="password-toggle" aria-label="Toggle Password Visibility">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </button>
              </div>
            </div>

            <!-- Confirm Password -->
            <div class="form-group">
              <div class="form-input-container">
                <input type="password" id="confirm_new_password" class="form-input" placeholder=" " required autocomplete="new-password">
                <label for="confirm_new_password" class="form-label">Confirm New Password</label>
                <button type="button" class="password-toggle" aria-label="Toggle Password Visibility">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </button>
              </div>
            </div>

            <button type="submit" class="btn btn-danger" style="width: 100%; padding: 12px; font-weight: 600;">Update Password</button>
          </form>
        </section>

      </div>

    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/app.js"></script>
  <script src="/js/auth.js"></script>
</body>
</html>
