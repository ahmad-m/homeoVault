<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HomeoVault - Homeopathic Inventory Management System</title>
  <meta name="description" content="A professional and secure family homeopathic medicine inventory system. Track batches, monitor stock levels, and receive expiration alerts.">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>

  <!-- Header Section -->
  <header class="header glassmorphism">
    <div class="container nav-container">
      <a href="/" class="logo">
        <div class="logo-icon">H</div>
        Homeo<span>Vault</span>
      </a>
      
      <button class="nav-toggle" id="nav-toggle" aria-label="Toggle Navigation">
        <i>☰</i>
      </button>

      <ul class="nav-links" id="nav-links">
        <li><a href="/" class="nav-link active">Home</a></li>
        <li><a href="#features" class="nav-link">Features</a></li>
        <li><a href="/dashboard" class="btn btn-primary" style="padding: 0.5rem 1.25rem;">Dashboard</a></li>
      </ul>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="py-xl" style="background: radial-gradient(circle at top right, rgba(16, 185, 129, 0.08), transparent 50%);">
    <div class="container text-center py-xl" style="max-width: 800px;">
      <h1 class="text-primary mt-md mb-md" style="font-family: var(--font-heading); font-size: 3.5rem; font-weight: 800; line-height: 1.15; letter-spacing: -0.02em;">
        Precision Inventory for <span class="text-accent" style="text-shadow: 0 0 30px var(--primary-glow);">Homeopathic Medicine</span>
      </h1>
      <p class="text-secondary mb-xl" style="font-size: 1.15rem; max-width: 650px; margin-left: auto; margin-right: auto; line-height: 1.6;">
        Securely log, monitor, and optimize your medicine cabinets with intelligent batch tracking, low-stock warnings, and real-time activity histories. Keep your family's health cataloged.
      </p>
      <div class="flex justify-center gap-md">
        <a href="/dashboard" class="btn btn-primary btn-lg">Launch Dashboard</a>
        <a href="#features" class="btn btn-secondary btn-lg">Explore Features</a>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-xl" style="background-color: var(--bg-secondary); border-top: 1px solid var(--bg-tertiary);">
    <div class="container">
      <div class="text-center mb-xl">
        <h2 class="text-primary mb-sm" style="font-family: var(--font-heading); font-size: 2.25rem; font-weight: 700;">Engineered for Smart Tracking</h2>
        <p class="text-secondary" style="max-width: 500px; margin: 0 auto;">Everything you need to manage a comprehensive cabinet, tailored for dilution potencies and mother tinctures.</p>
      </div>

      <div class="grid grid-3 gap-lg">
        <!-- Feature Card 1 -->
        <div class="card">
          <div class="card-title">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary);"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>
            Medicine Inventory
          </div>
          <div class="card-body">
            Create structured records of your remedies. Log dilutions (e.g., 30C, 200C), mother tinctures, triturations, and custom brand profiles.
          </div>
        </div>

        <!-- Feature Card 2 -->
        <div class="card">
          <div class="card-title">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary);"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
            Stock In & Out
          </div>
          <div class="card-body">
            Instantly log additions and consumption batches. Track who updated the levels and trace historical trends dynamically.
          </div>
        </div>

        <!-- Feature Card 3 -->
        <div class="card">
          <div class="card-title">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary);"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            Critical Warnings
          </div>
          <div class="card-body">
            Get instant alerts when medicine stock levels cross minimum safety thresholds or approach expiration boundaries.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-xl text-center">
    <div class="container py-lg">
      <div class="glassmorphism" style="border-radius: var(--radius-xl); padding: var(--spacing-xxl) var(--spacing-xl); box-shadow: var(--shadow-xl);">
        <h2 class="text-primary mb-md" style="font-family: var(--font-heading); font-size: 2rem; font-weight: 700;">Ready to secure your medicine cabinet?</h2>
        <p class="text-secondary mb-lg" style="max-width: 550px; margin: 0 auto; line-height: 1.6;">Join the modern approach to holistic remedy tracking. No more guessing if you have enough Arnica or Nux Vomica.</p>
        <a href="/dashboard" class="btn btn-primary">Open Dashboard</a>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script src="/js/app.js"></script>
</body>
</html>
