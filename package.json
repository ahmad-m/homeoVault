{
  "name": "homeovault",
  "version": "1.0.0",
  "description": "Homeopathic Inventory Management System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node tests/runTests.js",
    "db:setup": "node backend/database/database.js",
    "db:migrate": "node backend/database/migrations/migrationRunner.js",
    "db:migrate:undo": "node backend/database/migrations/migrationRunner.js rollback",
    "db:seed": "node backend/database/seed/seedRunner.js",
    "db:seed:undo": "node backend/database/seed/seedRunner.js rollback"
  },
  "keywords": [
    "homeopathy",
    "inventory",
    "management"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "ejs": "^6.0.1",
    "express": "^4.19.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.22.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
